@startuml use-case-diagram
title Online Vehicle Reservation System - Use Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam backgroundColor white

actor "Staff Member" as Staff
actor "Administrator" as Admin
Admin --|> Staff

rectangle "Sunrise Vehicle Rentals\nOnline Vehicle Reservation System" {

    usecase "Login"                                as UC1
    usecase "Register New Reservation"              as UC2
    usecase "Check Vehicle Availability"            as UC2a
    usecase "Register New Customer"                 as UC2b
    usecase "Generate Reservation Number"           as UC2c
    usecase "Search / View Reservation Details"     as UC3
    usecase "Calculate and Print Bill"               as UC4
    usecase "Calculate Total Cost"                  as UC4a
    usecase "Apply Weekend Surcharge"                as UC4b
    usecase "Apply Long-Term Discount"               as UC4c
    usecase "Record Payment"                        as UC4d
    usecase "Cancel Reservation"                    as UC5
    usecase "View Help"                             as UC6
    usecase "Logout"                                as UC7
    usecase "Manage Vehicle Fleet"                  as UC8
    usecase "Manage Vehicle Categories & Rates"     as UC9
    usecase "Manage Staff Accounts"                 as UC10
    usecase "View Decision-Support Reports"          as UC11

    Staff -- UC1
    Staff -- UC2
    Staff -- UC3
    Staff -- UC4
    Staff -- UC5
    Staff -- UC6
    Staff -- UC7
    Staff -- UC11

    Admin -- UC8
    Admin -- UC9
    Admin -- UC10

    UC2 .> UC2a : <<include>>
    UC2 .> UC2c : <<include>>
    UC2b .> UC2 : <<extend>>
    note right of UC2b
      Extension point: "new customer"
      Triggered only when the staff member
      does not select an existing customer.
    end note

    UC4 .> UC4a : <<include>>
    UC4b .> UC4a : <<extend>>
    note right of UC4b
      Extension point: "weekend pickup"
      Fires only when the pickup date
      falls on Fri/Sat/Sun.
    end note
    UC4c .> UC4a : <<extend>>
    note right of UC4c
      Extension point: "long-term rental"
      Fires only when duration >= 7 days.
    end note
    UC4 .> UC4d : <<include>>
}

note bottom of UC1
  All use cases other than Login require an
  authenticated staff session (JWT held in an
  HttpOnly cookie, verified on every request).
end note

@enduml
