@startuml sequence-03-calculate-print-bill
title Sequence Diagram 3 - Calculate and Print Bill
skinparam backgroundColor white
actor "Staff Member" as Staff
participant "Billing Page\n(billing.html / billing.js)" as UI
participant "BillController" as Ctrl
participant "BillServiceImpl" as Svc
participant "ReservationRepository" as ResRepo
participant "BillRepository" as BillRepo
participant "BillFactory" as Factory
participant "PricingContext" as Context
participant "PricingStrategy\n(Standard / Weekend / LongTerm)" as Strategy
participant "ReservationEventPublisher" as Publisher
database "MySQL" as DB

Staff -> UI : open reservation, click "Generate / View Bill"
UI -> Ctrl : GET /api/bills/reservation/{reservationNumber}
Ctrl -> Svc : generateOrFetch(reservationNumber)

Svc -> ResRepo : findByReservationNumber(reservationNumber)
ResRepo -> DB : SELECT * FROM reservations WHERE reservation_number = ?
DB --> ResRepo : Reservation row
ResRepo --> Svc : Reservation

Svc -> BillRepo : findByReservationId(reservation.id)

alt bill already generated
    BillRepo -> DB : SELECT * FROM bills WHERE reservation_id = ?
    DB --> BillRepo : Bill row
    BillRepo --> Svc : Bill (existing, figures unchanged)
else no bill yet
    BillRepo --> Svc : empty
    Svc -> Factory : create(reservation)
    Factory -> Factory : days = max(1, DATEDIFF(returnDate, pickupDate))
    Factory -> Context : price(dailyRate, days, pickupDate)
    Context -> Context : resolveStrategy(days, pickupDate)
    Context -> Strategy : calculate(dailyRate, days, pickupDate)
    Strategy --> Context : PricingResult(subtotal, surcharge,\ndiscount, tax, total)
    Context --> Factory : PricingResult
    Factory --> Svc : Bill (unsaved)

    Svc -> BillRepo : save(bill)
    BillRepo -> DB : INSERT INTO bills
    DB --> BillRepo : saved Bill
    BillRepo --> Svc : Bill

    Svc -> Publisher : publish(ReservationEvent(BILL_GENERATED))
end

Svc --> Ctrl : BillResponse
Ctrl --> UI : 200 OK {billNumber, totalAmount, ...}
UI --> Staff : render printable receipt

Staff -> UI : click "Print Receipt"
UI -> UI : window.print()  (browser print / save-as-PDF dialog)

@enduml
